# DealCRM Environment Variables
# Copy this to .env and fill in your values

# ─── AI provider (any OpenAI-compatible chat endpoint) ───
# Option A: local model via Ollama (no API key, notes never leave your machine).
#   Install Ollama, run `ollama pull qwen2.5:7b`, then set:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b   # ~4.7GB, fits an 8GB GPU; pick a 7-8B model sized to your VRAM
# LLM_API_KEY=
# LLM_TIMEOUT=180        # seconds
# LLM_MAX_TOKENS=2048

# Option B: hosted DeepSeek (used only when LLM_BASE_URL is empty).
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# ─── OCR for scanned PDFs (optional) ───
# Only needed if a PDF has no selectable text. Install Tesseract, then either put it on
# PATH or point at the binary here. On Linux/Docker (apt-get install tesseract-ocr) it's
# auto-detected on PATH, so leave this empty there.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# HTTP Basic Auth credentials
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# SQLite database path
DATABASE_PATH=/data/crm.db

# Shared secret for the inbound-email webhook. Generate a random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Then point your inbound-email provider at:  https://<your-app>/inbound/email?token=<this value>
# Leave empty to disable the email webhook (the paste box still works).
INBOUND_TOKEN=
