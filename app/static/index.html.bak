<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#0F1117">
<link rel="manifest" href="/manifest.json">
<title>DealCRM</title>
<script src="https://cdn.jsdelivr.net/npm/@tiptap/core@2.9.1/dist/tiptap-core.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@tiptap/starter-kit@2.9.1/dist/tiptap-starter-kit.umd.min.js"></script>
<style>
:root {
  --bg: #0F1117; --surface: #1A1D27; --surface2: #22262F; --surface3: #2A2E38;
  --text: #E4E6ED; --text2: #9CA3AF; --text3: #6B7280;
  --accent: #4F8EF7; --accent-dim: #3A6FD8; --green: #34D399; --red: #F87171;
  --orange: #FBBF24; --purple: #A78BFA; --border: #2A2E38;
  --radius: 6px; --radius-lg: 10px;
  --font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --font-mono: "SF Mono", "Fira Code", "Fira Mono", monospace;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-size: 13px; -webkit-text-size-adjust: 100%; }
body {
  font-family: var(--font); background: var(--bg); color: var(--text);
  line-height: 1.5; min-height: 100dvh; overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}
a { color: var(--accent); text-decoration: none; }
button { font-family: inherit; cursor: pointer; border: none; outline: none; }
input, textarea, select { font-family: inherit; font-size: inherit; outline: none; }

/* Layout */
.app { max-width: 1200px; margin: 0 auto; padding: 0 16px 80px; }
.header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16px 16px 12px; border-bottom: 1px solid var(--border);
  position: sticky; top: 0; background: var(--bg); z-index: 50;
}
.header h1 { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.3px; }
.header h1 span { color: var(--accent); }

/* Tabs */
.tabs {
  display: flex; gap: 0; border-bottom: 1px solid var(--border);
  position: sticky; top: 49px; background: var(--bg); z-index: 49;
  overflow-x: auto; -webkit-overflow-scrolling: touch;
}
.tabs button {
  padding: 10px 16px; font-size: 0.85rem; font-weight: 500;
  color: var(--text2); background: none; white-space: nowrap;
  border-bottom: 2px solid transparent; transition: all 0.15s;
}
.tabs button:hover { color: var(--text); }
.tabs button.active { color: var(--accent); border-bottom-color: var(--accent); }

/* Bottom nav (mobile) */
.bottom-nav {
  display: none; position: fixed; bottom: 0; left: 0; right: 0;
  background: var(--surface); border-top: 1px solid var(--border);
  z-index: 100; padding: 4px 0 env(safe-area-inset-bottom, 4px);
}
.bottom-nav .nav-items { display: flex; justify-content: space-around; }
.bottom-nav button {
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  padding: 6px 8px; font-size: 0.65rem; color: var(--text3); background: none;
  min-width: 48px;
}
.bottom-nav button.active { color: var(--accent); }
.bottom-nav button svg { width: 20px; height: 20px; stroke-width: 1.5; }

/* Tab content */
.tab-content { display: none; padding-top: 16px; }
.tab-content.active { display: block; }

/* Stats bar */
.stats-bar { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin-bottom: 20px; }
.stat-card {
  background: var(--surface); border-radius: var(--radius); padding: 14px 16px;
  border: 1px solid var(--border);
}
.stat-card .stat-value { font-size: 1.6rem; font-weight: 700; line-height: 1.2; }
.stat-card .stat-label { font-size: 0.75rem; color: var(--text2); margin-top: 2px; }
.stat-card .stat-value.accent { color: var(--accent); }
.stat-card .stat-value.green { color: var(--green); }
.stat-card .stat-value.orange { color: var(--orange); }

/* Section headers */
.section-title {
  font-size: 0.8rem; font-weight: 600; color: var(--text2); text-transform: uppercase;
  letter-spacing: 0.5px; margin: 20px 0 10px; padding-bottom: 8px;
  border-bottom: 1px solid var(--border);
}

/* Todo items */
.todo-item {
  display: flex; align-items: center; gap: 10px; padding: 10px 12px;
  border-radius: var(--radius); cursor: pointer; transition: background 0.1s;
  border: 1px solid transparent;
}
.todo-item:hover { background: var(--surface2); border-color: var(--border); }
.todo-item.done { opacity: 0.5; }
.todo-item.done .todo-title { text-decoration: line-through; }
.todo-check {
  width: 18px; height: 18px; border-radius: 4px; border: 2px solid var(--text3);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  transition: all 0.15s;
}
.todo-check.checked { background: var(--accent); border-color: var(--accent); }
.todo-check.checked::after { content: "✓"; color: white; font-size: 11px; }
.todo-content { flex: 1; min-width: 0; }
.todo-title { font-size: 0.9rem; }
.todo-meta { font-size: 0.75rem; color: var(--text3); margin-top: 1px; }
.badge {
  display: inline-block; padding: 1px 7px; border-radius: 10px;
  font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px;
}
.badge.high { background: rgba(248,113,113,0.15); color: var(--red); }
.badge.medium { background: rgba(251,191,36,0.15); color: var(--orange); }
.badge.low { background: rgba(52,211,153,0.15); color: var(--green); }
.badge.ai { background: rgba(167,139,250,0.15); color: var(--purple); }

/* Notes feed */
.note-feed { display: flex; flex-direction: column; gap: 8px; }
.note-card {
  background: var(--surface); border-radius: var(--radius); padding: 12px 14px;
  border: 1px solid var(--border);
}
.note-card .note-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.note-card .note-entity { font-size: 0.75rem; color: var(--accent); font-weight: 600; }
.note-card .note-date { font-size: 0.7rem; color: var(--text3); }
.note-card .note-body { font-size: 0.8rem; color: var(--text); max-height: 60px; overflow: hidden; }
.note-card .note-summary {
  font-size: 0.8rem; color: var(--purple); margin-top: 8px; padding: 8px;
  background: rgba(167,139,250,0.05); border-radius: 4px; border-left: 2px solid var(--purple);
}

/* Table */
.table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; margin-bottom: 16px; }
table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
th {
  text-align: left; padding: 10px 12px; font-size: 0.7rem; font-weight: 600;
  color: var(--text2); text-transform: uppercase; letter-spacing: 0.5px;
  border-bottom: 1px solid var(--border); white-space: nowrap;
}
td { padding: 10px 12px; border-bottom: 1px solid var(--border); }
tr:hover td { background: var(--surface2); }
tr { cursor: pointer; }

/* Search & filter bar */
.toolbar { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }
.toolbar input, .toolbar select {
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
  color: var(--text); padding: 8px 12px; font-size: 0.85rem;
}
.toolbar input { flex: 1; min-width: 150px; }
.toolbar select { min-width: 120px; }
.toolbar input:focus, .toolbar select:focus { border-color: var(--accent); }

/* Buttons */
.btn {
  display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px;
  border-radius: var(--radius); font-size: 0.85rem; font-weight: 500;
  transition: all 0.15s; white-space: nowrap;
}
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover { background: var(--accent-dim); }
.btn-secondary { background: var(--surface2); color: var(--text); border: 1px solid var(--border); }
.btn-secondary:hover { background: var(--surface3); }
.btn-danger { background: rgba(248,113,113,0.15); color: var(--red); }
.btn-danger:hover { background: rgba(248,113,113,0.25); }
.btn-sm { padding: 5px 10px; font-size: 0.75rem; border-radius: 4px; }

/* Kanban */
.kanban { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 12px; }
.kanban-col { background: var(--surface); border-radius: var(--radius); border: 1px solid var(--border); padding: 12px; }
.kanban-col h3 {
  font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;
  color: var(--text2); margin-bottom: 10px;
}
.kanban-card {
  background: var(--surface2); border-radius: var(--radius); padding: 12px;
  margin-bottom: 8px; cursor: pointer; border: 1px solid var(--border);
  transition: border-color 0.15s;
}
.kanban-card:hover { border-color: var(--accent); }
.kanban-card .card-name { font-weight: 600; font-size: 0.9rem; margin-bottom: 4px; }
.kanban-card .card-meta { display: flex; gap: 6px; flex-wrap: wrap; }
.kanban-card .type-badge {
  padding: 2px 8px; border-radius: 10px; font-size: 0.65rem; font-weight: 600;
  text-transform: uppercase; background: rgba(79,142,247,0.15); color: var(--accent);
}
.kanban-card .size-tag { font-size: 0.7rem; color: var(--text2); }

/* Modals / Slide panels */
.modal-overlay {
  display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6);
  z-index: 200; align-items: center; justify-content: center;
}
.modal-overlay.open { display: flex; }
.modal {
  background: var(--surface); border-radius: var(--radius-lg); border: 1px solid var(--border);
  width: 90%; max-width: 520px; max-height: 85vh; overflow-y: auto; padding: 20px;
}
.modal h2 { font-size: 1.1rem; margin-bottom: 16px; }
.modal .form-group { margin-bottom: 12px; }
.modal .form-group label { display: block; font-size: 0.75rem; color: var(--text2); margin-bottom: 4px; font-weight: 500; }
.modal .form-group input, .modal .form-group select, .modal .form-group textarea {
  width: 100%; padding: 8px 10px; background: var(--surface2); border: 1px solid var(--border);
  border-radius: var(--radius); color: var(--text); font-size: 0.85rem;
}
.modal .form-group textarea { resize: vertical; min-height: 80px; font-family: inherit; }
.modal .form-group input:focus, .modal .form-group select:focus, .modal .form-group textarea:focus { border-color: var(--accent); }
.modal .modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px; }

/* Slide-in detail panel */
.detail-panel {
  position: fixed; top: 0; right: -100%; width: 100%; max-width: 480px; height: 100dvh;
  background: var(--surface); z-index: 300; overflow-y: auto; transition: right 0.25s ease;
  padding: 20px; border-left: 1px solid var(--border);
}
.detail-panel.open { right: 0; }
.detail-panel .close-btn {
  position: absolute; top: 12px; right: 12px;
  background: var(--surface2); border-radius: 50%; width: 32px; height: 32px;
  display: flex; align-items: center; justify-content: center; color: var(--text2);
  font-size: 1.2rem;
}
.detail-panel .close-btn:hover { background: var(--surface3); color: var(--text); }
.detail-overlay {
  display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 299;
}
.detail-overlay.open { display: block; }

/* Tags */
.tag-list { display: flex; flex-wrap: wrap; gap: 4px; }
.tag {
  padding: 2px 8px; border-radius: 10px; font-size: 0.7rem; font-weight: 500;
  background: var(--surface3); color: var(--text2);
}

/* Tag multi-select */
.tag-select { display: flex; flex-wrap: wrap; gap: 4px; }
.tag-select .tag-option {
  padding: 4px 10px; border-radius: 12px; font-size: 0.75rem; cursor: pointer;
  background: var(--surface3); color: var(--text2); border: 1px solid transparent;
  transition: all 0.15s;
}
.tag-select .tag-option.selected { background: rgba(79,142,247,0.2); color: var(--accent); border-color: var(--accent); }

/* Tiptap editor */
.tiptap-editor {
  background: var(--surface2); border: 1px solid var(--border); border-radius: 0 0 var(--radius) var(--radius);
  min-height: 200px; padding: 12px; font-size: 0.9rem; color: var(--text);
  line-height: 1.6; outline: none;
}
.tiptap-editor p { margin-bottom: 8px; }
.tiptap-editor h1, .tiptap-editor h2, .tiptap-editor h3 { margin: 16px 0 8px; }
.tiptap-editor ul, .tiptap-editor ol { padding-left: 20px; margin-bottom: 8px; }
.tiptap-editor blockquote { border-left: 3px solid var(--accent); padding-left: 12px; color: var(--text2); margin: 8px 0; }
.tiptap-editor code { background: var(--surface3); padding: 2px 6px; border-radius: 3px; font-family: var(--font-mono); font-size: 0.8rem; }
.tiptap-toolbar {
  display: flex; gap: 2px; padding: 6px; background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius) var(--radius) 0 0; border-bottom: none; flex-wrap: wrap;
}
.tiptap-toolbar button {
  padding: 4px 8px; background: none; color: var(--text2); border-radius: 4px; font-size: 0.85rem;
}
.tiptap-toolbar button:hover { background: var(--surface2); color: var(--text); }
.tiptap-toolbar button.is-active { background: var(--accent); color: #fff; }

/* Empty state */
.empty { text-align: center; padding: 40px 20px; color: var(--text3); }
.empty p { font-size: 0.9rem; }

/* Spinner */
.spinner {
  display: inline-block; width: 16px; height: 16px; border: 2px solid var(--text3);
  border-top-color: var(--accent); border-radius: 50%; animation: spin 0.6s linear infinite;
  vertical-align: middle; margin-right: 6px;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* Loading / overlay */
.loading-overlay {
  display: none; position: fixed; inset: 0; background: rgba(15,17,23,0.8);
  z-index: 400; align-items: center; justify-content: center; flex-direction: column; gap: 12px;
}
.loading-overlay.show { display: flex; }
.loading-overlay .spinner { width: 32px; height: 32px; border-width: 3px; margin-right: 0; }

/* Detail section */
.detail-section { margin-bottom: 16px; }
.detail-section h4 { font-size: 0.7rem; font-weight: 600; color: var(--text2); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; }
.detail-section p { font-size: 0.85rem; margin-bottom: 4px; }
.detail-section .label { color: var(--text3); font-size: 0.7rem; }

/* Entity picker in notes tab */
.entity-picker { display: flex; gap: 8px; margin-bottom: 12px; align-items: center; flex-wrap: wrap; }
.entity-picker label { font-size: 0.8rem; color: var(--text2); white-space: nowrap; }
.entity-picker select {
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
  color: var(--text); padding: 8px 12px; font-size: 0.85rem; min-width: 150px;
}

/* Responsive */
@media (max-width: 768px) {
  .app { padding: 0 8px 80px; }
  .header { padding: 12px 8px; }
  .tabs { display: none; }
  .bottom-nav { display: block; }
  .kanban { grid-template-columns: 1fr; }
  .stats-bar { grid-template-columns: repeat(2, 1fr); }
  .modal { width: 95%; max-width: none; border-radius: var(--radius-lg) var(--radius-lg) 0 0; margin-top: auto; max-height: 90vh; }
  .modal-overlay { align-items: flex-end; }
  .detail-panel { max-width: 100%; }
}
@media (min-width: 769px) {
  .bottom-nav { display: none; }
  .tabs { display: flex; }
}
</style>
</head>
<body>

<div class="loading-overlay" id="loading">
  <div class="spinner"></div>
  <span style="color:var(--text2);font-size:0.85rem">Processing...</span>
</div>

<div class="detail-overlay" id="detailOverlay" onclick="closeDetail()"></div>
<div class="detail-panel" id="detailPanel"></div>

<div class="modal-overlay" id="modalOverlay">
  <div class="modal" id="modalContent"></div>
</div>

<div id="app">
  <div class="header">
    <h1>Deal<span>CRM</span></h1>
  </div>
  <nav class="tabs" id="tabs">
    <button data-tab="dashboard" class="active">Dashboard</button>
    <button data-tab="contacts">Contacts</button>
    <button data-tab="deals">Deals</button>
    <button data-tab="notes">Notes</button>
  </nav>

  <div class="app">
    <!-- Dashboard -->
    <div class="tab-content active" id="tab-dashboard">
      <div class="stats-bar" id="statsBar"></div>
      <div id="todoGroups"></div>
      <div class="section-title">Recent Notes</div>
      <div class="note-feed" id="recentNotes"></div>
    </div>

    <!-- Contacts -->
    <div class="tab-content" id="tab-contacts">
      <div class="toolbar">
        <input type="text" id="contactSearch" placeholder="Search contacts..." oninput="loadContacts()">
        <select id="contactTagFilter" onchange="loadContacts()">
          <option value="">All tags</option>
        </select>
        <button class="btn btn-primary" onclick="openContactModal()">+ Add Contact</button>
      </div>
      <div class="table-wrap"><table><thead><tr>
        <th>Name</th><th>Firm</th><th>Title</th><th>Email</th><th>Tags</th>
      </tr></thead><tbody id="contactTable"></tbody></table></div>
    </div>

    <!-- Deals -->
    <div class="tab-content" id="tab-deals">
      <div style="margin-bottom:12px">
        <button class="btn btn-primary" onclick="openDealModal()">+ New Deal</button>
      </div>
      <div class="kanban" id="kanban"></div>
    </div>

    <!-- Notes -->
    <div class="tab-content" id="tab-notes">
      <div class="entity-picker">
        <label>Linked to:</label>
        <select id="noteEntityType" onchange="onNoteEntityChange()">
          <option value="">None (standalone)</option>
          <option value="contact" selected>Contact</option>
          <option value="deal">Deal</option>
        </select>
        <select id="noteEntityId">
          <option value="">Select...</option>
        </select>
      </div>
      <div class="tiptap-toolbar" id="tiptapToolbar">
        <button data-action="bold" title="Bold"><b>B</b></button>
        <button data-action="italic" title="Italic"><i>I</i></button>
        <button data-action="bullet-list" title="Bullet list">&#8226;</button>
        <button data-action="ordered-list" title="Numbered list">1.</button>
        <button data-action="blockquote" title="Quote">"</button>
        <button data-action="code" title="Code">&lt;/&gt;</button>
        <button data-action="heading-2" title="Heading 2">H2</button>
      </div>
      <div class="tiptap-editor" id="tiptapEditor"></div>
      <div style="margin-top:12px;display:flex;gap:8px;align-items:center">
        <button class="btn btn-primary" onclick="saveNote()" id="saveNoteBtn">Save Note</button>
        <span id="noteSaveStatus" style="font-size:0.8rem;color:var(--text3)"></span>
      </div>
      <div class="section-title" style="margin-top:20px">Note History</div>
      <input type="text" id="noteSearch" placeholder="Search notes..." style="width:100%;margin-bottom:12px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);padding:8px 12px;font-size:0.85rem" oninput="loadNoteHistory()">
      <div class="note-feed" id="noteHistory"></div>
    </div>
  </div>

  <nav class="bottom-nav" id="bottomNav">
    <div class="nav-items">
      <button data-tab="dashboard" class="active">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        Home
      </button>
      <button data-tab="contacts">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Contacts
      </button>
      <button data-tab="deals">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        Deals
      </button>
      <button data-tab="notes">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Notes
      </button>
    </div>
  </nav>
</div>

<script>
// ─── Constants ───
const TAGS = ["Investor","LP","Banker","Lawyer","Operator","Founder","Portfolio Co","Service Provider","Other"];
const DEAL_TYPE_LABELS = {"sell-side":"Sell-Side","buy-side":"Buy-Side","credit":"Credit","independent-sponsor":"Independent Sponsor"};
const DEAL_STAGES = ["prospect","active","closed","dead"];
let tiptapEditor = null;
let activeTab = 'dashboard';

// ─── API helper (HTTP Basic Auth handled by browser) ───
async function api(path, opts = {}) {
  const res = await fetch(path, {
    headers: { 'Content-Type': 'application/json', ...opts.headers },
    ...opts,
  });
  if (!res.ok) {
    const err = await res.json().catch(() => ({ detail: res.statusText }));
    throw new Error(err.detail || 'Request failed');
  }
  return res.json();
}

// ─── Loading ───
function showLoading(show) { document.getElementById('loading').classList.toggle('show', show); }

// ─── Tabs ───
function switchTab(name) {
  if (activeTab === name && document.getElementById('tab-' + name).classList.contains('active')) return;
  activeTab = name;
  document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.tabs button, .bottom-nav button').forEach(b => b.classList.remove('active'));
  const tabEl = document.getElementById('tab-' + name);
  if (tabEl) tabEl.classList.add('active');
  document.querySelectorAll('[data-tab="' + name + '"]').forEach(b => b.classList.add('active'));
  window.location.hash = name;
  if (name === 'dashboard') loadDashboard();
  else if (name === 'contacts') loadContacts();
  else if (name === 'deals') loadDeals();
  else if (name === 'notes') initNotesTab();
}

document.querySelectorAll('[data-tab]').forEach(btn => {
  btn.addEventListener('click', () => switchTab(btn.dataset.tab));
});

// ─── Dashboard ───
async function loadDashboard() {
  try {
    const stats = await api('/dashboard/stats');
    const bar = document.getElementById('statsBar');
    bar.innerHTML =
      '<div class="stat-card"><div class="stat-value accent">' + stats.open_todos + '</div><div class="stat-label">Open Todos</div></div>' +
      '<div class="stat-card"><div class="stat-value green">' + stats.active_deals + '</div><div class="stat-label">Active Deals</div></div>' +
      '<div class="stat-card"><div class="stat-value orange">' + stats.total_contacts + '</div><div class="stat-label">Contacts</div></div>';

    // Todos grouped
    const todos = await api('/todos?status=open');
    const today = new Date(); today.setHours(23,59,59,999);
    const weekEnd = new Date(today.getTime() + 7*86400000);
    const todayTodos = [], weekTodos = [], laterTodos = [];

    todos.forEach(t => {
      if (!t.due_date) { laterTodos.push(t); return; }
      const d = new Date(t.due_date);
      if (d <= today) todayTodos.push(t);
      else if (d <= weekEnd) weekTodos.push(t);
      else laterTodos.push(t);
    });

    function renderGroup(title, items) {
      if (!items.length) return '';
      return '<div class="section-title">' + title + ' (' + items.length + ')</div>' +
        itemsObject.entries(DEAL_TYPE_LABELS).map(function(e) {
          let metaHtml = '';
          if (t.linked_entity_type) metaHtml += esc(t.linked_entity_type) + ' #' + t.linked_entity_id;
          if (t.source === 'ai') metaHtml += (metaHtml ? ' ' : '') + '<span class="badge ai">AI</span>';
          return '<div class="todo-item' + (t.status === 'done' ? ' done' : '') + '" onclick="toggleTodo(' + t.id + ',\'' + t.status + '\')">' +
            '<div class="todo-check' + (t.status === 'done' ? ' checked' : '') + '"></div>' +
            '<div class="todo-content">' +
              '<div class="todo-title">' + esc(t.title) + '</div>' +
              (metaHtml ? '<div class="todo-meta">' + metaHtml + '</div>' : '') +
            '</div>' +
            '<span class="badge ' + t.priority + '">' + t.priority + '</span>' +
          '</div>';
        }).join('');
    }

    document.getElementById('todoGroups').innerHTML =
      renderGroup('Today', todayTodos) +
      renderGroup('This Week', weekTodos) +
      renderGroup('Later', laterTodos) +
      (!todos.length ? '<div class="empty"><p>No open todos</p></div>' : '');

    // Recent notes
    var recentNotes = stats.recent_notes || [];
    document.getElementById('recentNotes').innerHTML = recentNotes.length ?
      recentNotes.map(function(n) {
        return '<div class="note-card">' +
          '<div class="note-header">' +
            '<span class="note-entity">' + esc(n.entity_type) + ' #' + (n.entity_id || '') + '</span>' +
            '<span class="note-date">' + fmtDate(n.created_at) + '</span>' +
          '</div>' +
          '<div class="note-body">' + esc((n.body_text || '').substring(0, 200)) + '</div>' +
          (n.ai_summary ? '<div class="note-summary">' + esc(n.ai_summary) + '</div>' : '') +
        '</div>';
      }).join('') :
      '<div class="empty"><p>No notes yet</p></div>';
  } catch (e) { console.error(e); }
}

async function toggleTodo(id, status) {
  var newStatus = status === 'done' ? 'open' : 'done';
  await api('/todos/' + id, { method: 'PUT', body: JSON.stringify({ status: newStatus }) });
  loadDashboard();
}

// ─── Contacts ───
async function loadContacts() {
  var search = document.getElementById('contactSearch').value;
  var tag = document.getElementById('contactTagFilter').value;
  var params = new URLSearchParams();
  if (search) params.set('search', search);
  if (tag) params.set('tag', tag);
  try {
    var contacts = await api('/contacts?' + params.toString());
    document.getElementById('contactTable').innerHTML = contacts.length ?
      contacts.map(function(c) {
        return '<tr onclick="openContactDetail(' + c.id + ')">' +
          '<td style="font-weight:600">' + esc(c.name) + '</td>' +
          '<td>' + esc(c.firm) + '</td>' +
          '<td>' + esc(c.title) + '</td>' +
          '<td style="font-size:0.8rem">' + esc(c.email) + '</td>' +
          '<td><div class="tag-list">' + (c.tags || [])Object.entries(DEAL_TYPE_LABELS).map(function(e) { return '<span class="tag">' + esc(t) + '</span>'; }).join('') + '</div></td>' +
        '</tr>';
      }).join('') :
      '<tr><td colspan="5" class="empty">No contacts found</td></tr>';

    // Populate tag filter
    var select = document.getElementById('contactTagFilter');
    if (select.options.length <= 1) {
      TAGS.forEach(function(t) {
        var o = document.createElement('option');
        o.value = t; o.textContent = t; select.appendChild(o);
      });
    }
  } catch (e) { console.error(e); }
}

async function openContactDetail(id) {
  showLoading(true);
  try {
    var contact = await api('/contacts/' + id);
    var deals = await api('/deals');
    var linkedDeals = deals.filter(function(d) { return (d.contact_ids || []).includes(id); });
    var notes = await api('/notes?entity_type=contact&entity_id=' + id);
    var todos = await api('/todos?entity_type=contact&entity_id=' + id);
    var openTodos = todos.filter(function(t) { return t.status === 'open'; });

    document.getElementById('detailPanel').innerHTML =
      '<button class="close-btn" onclick="closeDetail()">\u2715</button>' +
      '<h2 style="font-size:1.1rem;margin-bottom:2px">' + esc(contact.name) + '</h2>' +
      '<p style="font-size:0.8rem;color:var(--text2);margin-bottom:16px">' +
        esc(contact.title) + (contact.firm ? ' at ' + esc(contact.firm) : '') +
      '</p>' +
      '<div class="detail-section">' +
        '<h4>Info</h4>' +
        '<p><span class="label">Email:</span> ' + esc(contact.email) + '</p>' +
        '<p><span class="label">Phone:</span> ' + esc(contact.phone) + '</p>' +
        '<p><span class="label">Tags:</span> <span class="tag-list">' +
          (contact.tags || [])Object.entries(DEAL_TYPE_LABELS).map(function(e) { return '<span class="tag">' + esc(t) + '</span>'; }).join('') +
        '</span></p>' +
        (contact.summary_text ? '<p><span class="label">Summary:</span> ' + esc(contact.summary_text) + '</p>' : '') +
        '<div style="margin-top:8px">' +
          '<button class="btn btn-secondary btn-sm" onclick="openContactModal(' + contact.id + ')">Edit</button>' +
          '<button class="btn btn-danger btn-sm" style="margin-left:4px" onclick="deleteContact(' + contact.id + ')">Delete</button>' +
        '</div>' +
      '</div>' +
      '<div class="detail-section">' +
        '<h4>Linked Deals (' + linkedDeals.length + ')</h4>' +
        (linkedDeals.length ?
          linkedDeals.map(function(d) {
            return '<p style="cursor:pointer;color:var(--accent)" onclick="openDealDetail(' + d.id + ')">' +
              esc(d.name) + ' <span class="badge" style="background:rgba(79,142,247,0.15);color:var(--accent)">' + d.stage + '</span></p>';
          }).join('') :
          '<p style="color:var(--text3)">None</p>') +
      '</div>' +
      '<div class="detail-section">' +
        '<h4>Notes (' + notes.length + ')</h4>' +
        (notes.length ?
          notes.map(function(n) {
            return '<div class="note-card" style="margin-bottom:6px">' +
              '<div class="note-body">' + esc((n.body_text || '').substring(0, 150)) + '</div>' +
              (n.ai_summary ? '<div class="note-summary">' + esc(n.ai_summary) + '</div>' : '') +
            '</div>';
          }).join('') :
          '<p style="color:var(--text3)">No notes</p>') +
      '</div>' +
      '<div class="detail-section">' +
        '<h4>Open Todos (' + openTodos.length + ')</h4>' +
        (openTodos.length ?
          openTodosObject.entries(DEAL_TYPE_LABELS).map(function(e) {
            return '<p><span class="badge ' + t.priority + '">' + t.priority + '</span> ' + esc(t.title) + '</p>';
          }).join('') :
          '<p style="color:var(--text3)">None</p>') +
      '</div>';
    document.getElementById('detailPanel').classList.add('open');
    document.getElementById('detailOverlay').classList.add('open');
  } catch (e) { console.error(e); }
  showLoading(false);
}

function closeDetail() {
  document.getElementById('detailPanel').classList.remove('open');
  document.getElementById('detailOverlay').classList.remove('open');
}

async function deleteContact(id) {
  if (!confirm('Delete this contact?')) return;
  await api('/contacts/' + id, { method: 'DELETE' });
  closeDetail();
  loadContacts();
}

function openContactModal(id) {
  var isEdit = !!id;
  var modal = document.getElementById('modalContent');
  modal.innerHTML =
    '<h2>' + (isEdit ? 'Edit' : 'Add') + ' Contact</h2>' +
    '<form id="contactForm">' +
      '<div class="form-group"><label>Name *</label><input id="cName" required></div>' +
      '<div class="form-group"><label>Email</label><input type="email" id="cEmail"></div>' +
      '<div class="form-group"><label>Phone</label><input id="cPhone"></div>' +
      '<div class="form-group"><label>Firm</label><input id="cFirm"></div>' +
      '<div class="form-group"><label>Title</label><input id="cTitle"></div>' +
      '<div class="form-group"><label>Tags</label><div class="tag-select" id="cTags">' +
        TAGSObject.entries(DEAL_TYPE_LABELS).map(function(e) { return '<span class="tag-option" data-tag="' + t + '" onclick="toggleTag(this)">' + t + '</span>'; }).join('') +
      '</div></div>' +
      '<div class="form-group"><label>Summary</label><textarea id="cSummaryText"></textarea></div>' +
      '<div class="modal-actions">' +
        '<button type="button" class="btn btn-secondary" onclick="closeModal()">Cancel</button>' +
        '<button type="submit" class="btn btn-primary">' + (isEdit ? 'Update' : 'Create') + '</button>' +
      '</div>' +
    '</form>';
  document.getElementById('modalOverlay').classList.add('open');

  if (isEdit) {
    api('/contacts/' + id).then(function(c) {
      document.getElementById('cName').value = c.name || '';
      document.getElementById('cEmail').value = c.email || '';
      document.getElementById('cPhone').value = c.phone || '';
      document.getElementById('cFirm').value = c.firm || '';
      document.getElementById('cTitle').value = c.title || '';
      document.getElementById('cSummaryText').value = c.summary_text || '';
      (c.tags || []).forEach(function(t) {
        var el = document.querySelector('#cTags .tag-option[data-tag="' + t + '"]');
        if (el) el.classList.add('selected');
      });
    });
  }

  document.getElementById('contactForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    var data = {
      name: document.getElementById('cName').value,
      email: document.getElementById('cEmail').value,
      phone: document.getElementById('cPhone').value,
      firm: document.getElementById('cFirm').value,
      title: document.getElementById('cTitle').value,
      tags: Array.from(document.querySelectorAll('#cTags .tag-option.selected')).map(function(el) { return el.dataset.tag; }),
      summary_text: document.getElementById('cSummaryText').value,
    };
    showLoading(true);
    try {
      if (isEdit) await api('/contacts/' + id, { method: 'PUT', body: JSON.stringify(data) });
      else await api('/contacts', { method: 'POST', body: JSON.stringify(data) });
      closeModal();
      loadContacts();
    } catch (err) { alert(err.message); }
    showLoading(false);
  });
}

window.toggleTag = function(el) { el.classList.toggle('selected'); };

// ─── Deals ───
async function loadDeals() {
  try {
    var deals = await api('/deals');
    var stages = { prospect: [], active: [], closed: [], dead: [] };
    deals.forEach(function(d) { if (stages[d.stage]) stages[d.stage].push(d); });
    document.getElementById('kanban').innerHTML = Object.entries(stages).map(function(entry) {
      var stage = entry[0], items = entry[1];
      return '<div class="kanban-col">' +
        '<h3>' + stage + ' (' + items.length + ')</h3>' +
        items.map(function(d) {
          return '<div class="kanban-card" onclick="openDealDetail(' + d.id + ')">' +
            '<div class="card-name">' + esc(d.name) + '</div>' +
            '<div class="card-meta">' +
              '<span class="type-badge">' + (DEAL_TYPE_LABELS[d.type] || d.type) + '</span>' +
              (d.size_mm ? '<span class="size-tag">$' + d.size_mm + 'M</span>' : '') +
              ((d.contact_ids || []).length ? '<span class="tag">' + d.contact_ids.length + ' contacts</span>' : '') +
            '</div>' +
          '</div>';
        }).join('') +
      '</div>';
    }).join('');
  } catch (e) { console.error(e); }
}

async function openDealDetail(id) {
  showLoading(true);
  try {
    var deal = await api('/deals/' + id);
    var contactNames = '';
    if (deal.contact_ids && deal.contact_ids.length) {
      var contacts = await api('/contacts');
      contactNames = deal.contact_ids.map(function(cid) {
        var c = contacts.find(function(x) { return x.id === cid; });
        return c ? c.name : '#' + cid;
      }).join(', ');
    }
    var notes = await api('/notes?entity_type=deal&entity_id=' + id);
    var todos = await api('/todos?entity_type=deal&entity_id=' + id);
    var openTodos = todos.filter(function(t) { return t.status === 'open'; });

    document.getElementById('detailPanel').innerHTML =
      '<button class="close-btn" onclick="closeDetail()">\u2715</button>' +
      '<h2 style="font-size:1.1rem;margin-bottom:2px">' + esc(deal.name) + '</h2>' +
      '<p style="font-size:0.8rem;color:var(--text2);margin-bottom:16px">' +
        '<span class="type-badge">' + deal.type + '</span>' +
        ' <span class="badge" style="background:rgba(79,142,247,0.15);color:var(--accent)">' + deal.stage + '</span>' +
        (deal.size_mm ? ' <span style="color:var(--green)">$' + deal.size_mm + 'M</span>' : '') +
      '</p>' +
      '<div class="detail-section">' +
        '<h4>Details</h4>' +
        '<p><span class="label">Contacts:</span> ' + (contactNames || 'None') + '</p>' +
        '<p><span class="label">Tags:</span> <span class="tag-list">' +
          (deal.tags || [])Object.entries(DEAL_TYPE_LABELS).map(function(e) { return '<span class="tag">' + esc(t) + '</span>'; }).join('') +
        '</span></p>' +
        (deal.notes_text ? '<p><span class="label">Notes:</span> ' + esc(deal.notes_text) + '</p>' : '') +
        '<div style="margin-top:8px">' +
          '<button class="btn btn-secondary btn-sm" onclick="openDealModal(' + deal.id + ')">Edit</button>' +
          '<button class="btn btn-danger btn-sm" style="margin-left:4px" onclick="deleteDeal(' + deal.id + ')">Delete</button>' +
        '</div>' +
      '</div>' +
      '<div class="detail-section">' +
        '<h4>Notes (' + notes.length + ')</h4>' +
        (notes.length ?
          notes.map(function(n) {
            return '<div class="note-card" style="margin-bottom:6px">' +
              '<div class="note-body">' + esc((n.body_text || '').substring(0, 150)) + '</div>' +
              (n.ai_summary ? '<div class="note-summary">' + esc(n.ai_summary) + '</div>' : '') +
            '</div>';
          }).join('') :
          '<p style="color:var(--text3)">No notes</p>') +
      '</div>' +
      '<div class="detail-section">' +
        '<h4>Open Todos (' + openTodos.length + ')</h4>' +
        (openTodos.length ?
          openTodosObject.entries(DEAL_TYPE_LABELS).map(function(e) {
            return '<p><span class="badge ' + t.priority + '">' + t.priority + '</span> ' + esc(t.title) + '</p>';
          }).join('') :
          '<p style="color:var(--text3)">None</p>') +
      '</div>';
    document.getElementById('detailPanel').classList.add('open');
    document.getElementById('detailOverlay').classList.add('open');
  } catch (e) { console.error(e); }
  showLoading(false);
}

async function deleteDeal(id) {
  if (!confirm('Delete this deal?')) return;
  await api('/deals/' + id, { method: 'DELETE' });
  closeDetail();
  loadDeals();
}

function openDealModal(id) {
  var isEdit = !!id;
  var modal = document.getElementById('modalContent');
  modal.innerHTML =
    '<h2>' + (isEdit ? 'Edit' : 'New') + ' Deal</h2>' +
    '<form id="dealForm">' +
      '<div class="form-group"><label>Deal Name *</label><input id="dName" required></div>' +
      '<div class="form-group"><label>Type</label><select id="dType">' +
        DEAL_TYPE_LABELSObject.entries(DEAL_TYPE_LABELS).map(function(e) { return '<option value="' + t + '">' + e[1] + '</option>'; }).join('') +
      '</select></div>' +
      '<div class="form-group"><label>Stage</label><select id="dStage">' +
        DEAL_STAGES.map(function(s) { return '<option value="' + s + '">' + s.charAt(0).toUpperCase() + s.slice(1) + '</option>'; }).join('') +
      '</select></div>' +
      '<div class="form-group"><label>Size ($M)</label><input type="number" step="0.1" id="dSize"></div>' +
      '<div class="form-group"><label>Tags</label><input id="dTags" placeholder="Comma-separated"></div>' +
      '<div class="form-group"><label>Notes</label><textarea id="dNotesText"></textarea></div>' +
      '<div class="modal-actions">' +
        '<button type="button" class="btn btn-secondary" onclick="closeModal()">Cancel</button>' +
        '<button type="submit" class="btn btn-primary">' + (isEdit ? 'Update' : 'Create') + '</button>' +
      '</div>' +
    '</form>';
  document.getElementById('modalOverlay').classList.add('open');

  if (isEdit) {
    api('/deals/' + id).then(function(d) {
      document.getElementById('dName').value = d.name || '';
      document.getElementById('dType').value = d.type || 'independent-sponsor';
      document.getElementById('dStage').value = d.stage || 'prospect';
      document.getElementById('dSize').value = d.size_mm || '';
      document.getElementById('dTags').value = (d.tags || []).join(', ');
      document.getElementById('dNotesText').value = d.notes_text || '';
    });
  }

  document.getElementById('dealForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    var data = {
      name: document.getElementById('dName').value,
      type: document.getElementById('dType').value,
      stage: document.getElementById('dStage').value,
      size_mm: parseFloat(document.getElementById('dSize').value) || null,
      tags: document.getElementById('dTags').value.split(',').map(function(s) { return s.trim(); }).filter(Boolean),
      notes_text: document.getElementById('dNotesText').value,
    };
    showLoading(true);
    try {
      if (isEdit) await api('/deals/' + id, { method: 'PUT', body: JSON.stringify(data) });
      else await api('/deals', { method: 'POST', body: JSON.stringify(data) });
      closeModal();
      loadDeals();
    } catch (err) { alert(err.message); }
    showLoading(false);
  });
}

// ─── Notes ───
async function initNotesTab() {
  if (!tiptapEditor) {
    var el = document.getElementById('tiptapEditor');
    if (typeof window.Editor !== 'undefined') {
      tiptapEditor = new window.Editor({
        element: el,
        extensions: [window.StarterKit],
        content: '',
        onUpdate: function() {
          // Update toolbar active states
          updateToolbarState();
        },
      });

      // Toolbar buttons
      document.querySelectorAll('#tiptapToolbar button').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var action = btn.dataset.action;
          var chain = tiptapEditor.chain().focus();
          if (action === 'bold') chain.toggleBold().run();
          else if (action === 'italic') chain.toggleItalic().run();
          else if (action === 'bullet-list') chain.toggleBulletList().run();
          else if (action === 'ordered-list') chain.toggleOrderedList().run();
          else if (action === 'blockquote') chain.toggleBlockquote().run();
          else if (action === 'code') chain.toggleCode().run();
          else if (action === 'heading-2') chain.toggleHeading({ level: 2 }).run();
        });
      });
    }
  }
  await loadNoteEntities();
  loadNoteHistory();
}

function updateToolbarState() {
  if (!tiptapEditor) return;
  document.querySelectorAll('#tiptapToolbar button').forEach(function(btn) {
    var action = btn.dataset.action;
    var isActive = false;
    if (action === 'bold') isActive = tiptapEditor.isActive('bold');
    else if (action === 'italic') isActive = tiptapEditor.isActive('italic');
    else if (action === 'bullet-list') isActive = tiptapEditor.isActive('bulletList');
    else if (action === 'ordered-list') isActive = tiptapEditor.isActive('orderedList');
    else if (action === 'blockquote') isActive = tiptapEditor.isActive('blockquote');
    else if (action === 'code') isActive = tiptapEditor.isActive('code');
    else if (action === 'heading-2') isActive = tiptapEditor.isActive('heading', { level: 2 });
    if (isActive) btn.classList.add('is-active');
    else btn.classList.remove('is-active');
  });
}

async function onNoteEntityChange() {
  await loadNoteEntities();
}

async function loadNoteEntities() {
  var type = document.getElementById('noteEntityType').value;
  var select = document.getElementById('noteEntityId');
  select.innerHTML = '<option value="">Select...</option>';
  try {
    if (type === 'contact') {
      var contacts = await api('/contacts');
      contacts.forEach(function(c) {
        var o = document.createElement('option');
        o.value = c.id; o.textContent = c.name; select.appendChild(o);
      });
    } else {
      var deals = await api('/deals');
      deals.forEach(function(d) {
        var o = document.createElement('option');
        o.value = d.id; o.textContent = d.name; select.appendChild(o);
      });
    }
  } catch (e) { console.error(e); }
}

async function saveNote() {
  var entityType = document.getElementById('noteEntityType').value;
  var entityIdRaw = document.getElementById('noteEntityId').value;
  var entityId = entityIdRaw ? parseInt(entityIdRaw) : null;
  if (!entityId && entityType) { alert('Select a contact or deal'); return; }
  var bodyHtml = tiptapEditor ? tiptapEditor.getHTML() : '';
  var bodyText = tiptapEditor ? tiptapEditor.getText() : '';

  if (!bodyText.trim()) { alert('Note cannot be empty'); return; }

  var statusEl = document.getElementById('noteSaveStatus');
  var saveBtn = document.getElementById('saveNoteBtn');
  statusEl.innerHTML = '<span class="spinner"></span> Saving...';
  saveBtn.disabled = true;
  showLoading(true);
  try {
    await api('/notes', { method: 'POST', body: JSON.stringify({
      entity_type: entityType,
      entity_id: entityId,
      body_html: bodyHtml,
      body_text: bodyText,
    })});
    statusEl.textContent = 'Saved! AI analysis running...';
    if (tiptapEditor) tiptapEditor.commands.clearContent();
    // Poll for AI results after a delay
    setTimeout(async function() {
      await loadNoteHistory();
      statusEl.textContent = 'Done \u2713';
      saveBtn.disabled = false;
    }, 4000);
  } catch (err) {
    statusEl.textContent = 'Error: ' + err.message;
    saveBtn.disabled = false;
  }
  showLoading(false);
}

async function loadNoteHistory() {
  var search = document.getElementById('noteSearch') ? document.getElementById('noteSearch').value : '';
  var params = new URLSearchParams();
  if (search) params.set('search', search);
  params.set('limit', '30');
  try {
    var notes = await api('/notes?' + params.toString());
    document.getElementById('noteHistory').innerHTML = notes.length ?
      notes.map(function(n) {
        return '<div class="note-card">' +
          '<div class="note-header">' +
            '<span class="note-entity">' + esc(n.entity_type) + ' #' + (n.entity_id || '') + '</span>' +
            '<span class="note-date">' + fmtDate(n.created_at) + '</span>' +
          '</div>' +
          '<div class="note-body">' + esc((n.body_text || '').substring(0, 250)) + '</div>' +
          (n.ai_summary ? '<div class="note-summary">' + esc(n.ai_summary) + '</div>' : '') +
          ((n.ai_takeaways || []).length ? '<div style="font-size:0.75rem;color:var(--text2);margin-top:4px">\u{1F4CB} ' + n.ai_takeaways.length + ' AI takeaways</div>' : '') +
        '</div>';
      }).join('') :
      '<div class="empty"><p>No notes yet</p></div>';
  } catch (e) { console.error(e); }
}

// ─── Modal ───
function closeModal() {
  document.getElementById('modalOverlay').classList.remove('open');
  document.getElementById('modalContent').innerHTML = '';
}

document.getElementById('modalOverlay').addEventListener('click', function(e) {
  if (e.target === this) closeModal();
});

// ─── Utils ───
function esc(s) {
  if (!s) return '';
  var d = document.createElement('div');
  d.textContent = s;
  return d.innerHTML;
}

function fmtDate(iso) {
  if (!iso) return '';
  var d = new Date(iso);
  return d.toLocaleString();
}

// ─── Startup ───
(function init() {
  var hash = window.location.hash.replace('#', '');
  switchTab(hash || 'dashboard');

  // Register service worker
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js').catch(function() {});
  }
})();
</script>
</body>
</html>
